{
  "name": "merger-lab",
  "productName": "Merger Lab",
  "version": "0.8.5",
  "description": "Combina múltiples archivos de hoja de cálculo (xls, xlsx, csv, ods) en un único archivo de salida.",
  "author": "Alejandro Salguero Oviedo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalgueroOv/mergerlab.git"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:frontend\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:frontend": "vite build",
    "build:electron": "electron-builder",
    "dist": "npm run build:frontend && electron-builder",
    "dist:win": "npm run build:frontend && electron-builder --win nsis portable",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg",
    "dist:linux": "npm run build:frontend && electron-builder --linux AppImage",
    "test": "node --test electron/releaseNotes.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
